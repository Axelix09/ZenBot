# Copiá este archivo a .env y completá lo que necesites.
NODE_ENV=production

# Opcional: solo si vas a usar MongoDB en lugar de SQLite.
MONGODB_URI=

# API key de Hikari API (https://hikariapi.skyultraweb.com).
# La usan YTmp3, YTmp4 y Play como fuente principal.
# Para conseguir tu key tenés que registrarte en el sitio.
# Si queda vacía, esos comandos usan los respaldos.
APIKEY=
